# ---------------------------------------------------------------------------
# MiniLang Compiler Visualizer -- environment template
#
# Copy to .env and fill in as needed:
#     cp .env.example .env
#
# EVERY variable here is OPTIONAL. The project is designed to run fully offline
# with none of them set -- that is a hard requirement, not a nicety: the demo is
# given on a machine that may have no internet access, and nothing that depends
# on a network or an API key is allowed to be on the critical path.
#
# .env is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Logging ---------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR   (default: INFO)
MINILANG_LOG_LEVEL=INFO

# Format: json | text                     (default: json)
# Use "text" when tailing logs by eye during development.
MINILANG_LOG_FORMAT=json

# --- Optional LLM explanation layer (Tier C, plan section 7 step 4) --------
# The syntax error recovery engine is fully deterministic: edit distance,
# expected-token sets and a common-mistake table, all offline. The LLM layer
# only adds a one-line natural-language explanation on top of a suggestion that
# has ALREADY been computed without it.
#
# Leave ANTHROPIC_API_KEY unset and the app behaves identically, minus those
# explanation strings. Responses are cached to cache/llm.json so a given
# snippet is never sent twice, and so a rehearsed demo needs no network at all.
#
# ANTHROPIC_API_KEY=sk-ant-...
MINILANG_LLM_ENABLED=false
MINILANG_LLM_MODEL=claude-haiku-4-5-20251001
MINILANG_LLM_CACHE_PATH=cache/llm.json
