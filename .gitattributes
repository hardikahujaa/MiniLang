# ---------------------------------------------------------------------------
# Normalise line endings.
#
# Git for Windows ships with core.autocrlf=true, which rewrites line endings on
# checkout. That makes a file's bytes depend on which machine cloned it -- bad
# for a repo whose test suite compares a fixture byte-for-byte against a Python
# string constant, and bad for reproducible diffs between a Windows dev machine
# and Linux CI.
#
# Declaring the intent here overrides the local autocrlf setting for everyone.
# ---------------------------------------------------------------------------

# Default: detect text files, store as LF in the repo, check out as LF.
* text=auto eol=lf

# Explicit, so nobody has to rely on detection for the files that matter.
*.py     text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.ml     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.csv    text eol=lf
*.txt    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.env.example    text eol=lf

# Binary: never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.ico    binary
*.woff   binary
*.woff2  binary

# The vendored D3 bundle is third-party; keep it out of language statistics
# and out of diffs.
static/lib/** linguist-vendored
